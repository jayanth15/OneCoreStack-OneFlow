{"nodes": [{"id": "planner_2026_07_28_improvements_plan_coordinated_release", "label": "OneFlow Improvements Coordinated Release", "file_type": "document", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "1. Objective", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_dispatch_stock_rules", "label": "Party-Specific Dispatch Stock Rules", "file_type": "concept", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.2 Dispatch stock rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_dispatch_idempotency_marker", "label": "Dispatch Idempotency Marker", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.2 Idempotency", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit dispatch-level deduction marker is required because request status alone is not a reliable idempotency guard, especially under retries and concurrent completion attempts."}, {"id": "planner_2026_07_28_improvements_plan_supplier_receipt_reference", "label": "Supplier Dispatch Receipt Reference", "file_type": "concept", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.2 Receipt reference", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_gate_pass_reference_rules", "label": "Party-Specific Gate Pass References", "file_type": "concept", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.3 Gate Pass reference rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_gate_pass_audit_history", "label": "Append-Only Gate Pass Audit History", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.4 Gate Pass history rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Material Gate Pass actions must remain attributable and reconstructable after edits or soft deletion, so audit rows are append-only and contain actor and before/after context."}, {"id": "planner_2026_07_28_improvements_plan_attachment_document_feature", "label": "Attachment PDF Document Feature", "file_type": "concept", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.5 PDF attachment storage", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_database_backed_pdf_storage", "label": "Database-Backed PDF Storage", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.5 PDF attachment storage \u2014 Rationale", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A child table with binary content works on SQLite and PostgreSQL, stays inside the existing backup boundary, avoids base64 JSON inflation, and supports multiple independently managed documents."}, {"id": "planner_2026_07_28_improvements_plan_leaf_only_deduction", "label": "Canonical Leaf-Only Stock Deduction", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.6 Leaf-only deduction invariant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inventory mutations must identify one concrete leaf so a user-selected variant changes without distributing quantity across sibling variants or category aggregates."}, {"id": "planner_2026_07_28_improvements_plan_inventory_printing", "label": "Complete Inventory Printing", "file_type": "concept", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.7 Inventory printing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_complete_history_printing", "label": "Complete History Printing", "file_type": "concept", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "3.8 Complete history printing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planner_2026_07_28_improvements_plan_shared_print_report_utility", "label": "Shared Safe Print Report Utility", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "4.1 Frontend report utility", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reusable print shell, escaping layer, and all-pages fetch helper prevent duplicated unsafe HTML generation and reports limited to browser-visible pagination."}, {"id": "planner_2026_07_28_improvements_plan_transactional_stock_service", "label": "Transactional Stock Mutation Service", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "4.2 Backend stock service", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The caller must own one transaction covering target resolution, validation, deductions, leaf history, parent recomputation, dispatch state, and linked updates so partial completion cannot persist."}, {"id": "planner_2026_07_28_improvements_plan_alembic_migration_strategy", "label": "Alembic Migration Strategy", "file_type": "rationale", "source_file": "planner/2026-07-28-improvements-plan.md", "source_location": "5. Database Migrations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema changes must work on clean and populated SQLite databases and PostgreSQL without guessing historical stock state or using runtime create_all as the sole migration mechanism."}, {"id": "planner_2026_07_28_improvements