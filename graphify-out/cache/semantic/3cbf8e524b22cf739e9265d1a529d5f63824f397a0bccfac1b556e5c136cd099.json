{"nodes": [{"id": "docs_superpowers_specs_2026_06_27_grn_and_worktime_bug_fixes_design_search_combobox", "label": "SearchCombobox shared component (plain + list variants)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-grn-and-worktime-bug-fixes-design.md", "source_location": "lines 53-100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eliminates three hand-rolled comboboxes in grn/page.tsx and the broken base-ui Combobox in time-report; uses document pointerdown listener to fix the click race that the old setTimeout-on-blur had."}, {"id": "docs_superpowers_specs_2026_06_27_grn_and_worktime_bug_fixes_design_use_debounced_search", "label": "useDebouncedSearch hook", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-grn-and-worktime-bug-fixes-design.md", "source_location": "lines 55-74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_27_grn_and_worktime_bug_fixes_design_grn_linkable_pr_items_endpoint", "label": "GET /api/v1/grn/linkable-prs/{pr_id}/items endpoint", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-grn-and-worktime-bug-fixes-design.md", "source_location": "lines 111-121, 131-148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_27_grn_and_worktime_bug_fixes_design_grn_click_race_bug", "label": "GRN item click race bug (setTimeout onBlur)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-27-grn-and-worktime-bug-fixes-design.md", "source_location": "lines 12-18, 124-129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setTimeout(setOpen(false), 150) in onBlur fires before onMouseDown's setOpen(false) propagates through React's batched update, closing the dropdown mid-selection."}, {"id": "docs_superpowers_specs_2026_06_27_grn_